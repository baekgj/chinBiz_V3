# 친비즈 ERP 환경변수 (로컬 개발용)
# DB — 로컬 MySQL localhost, 계정 chin4_test/1234  (서버 배포 시 DB_HOST=175.125.94.198, DB_USER=chin4)
DB_HOST=localhost
DB_PORT=3306
DB_USER=chin4_test
DB_PASSWORD=1234
DB_NAME=chin4
DB_POOL_LIMIT=10

# JWT (Spring Boot 인증)
JWT_SECRET=change-this-to-a-very-long-random-secret-key-at-least-32-bytes-0123456789
JWT_EXPIRATION_MS=86400000

# CORS 허용 출처 (FE 서버). 포트가 바뀌어도 다시 안 고치도록 host 뒤에 :* 와일드카드 패턴 사용.
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://175.125.94.198:*

# 웹푸시(Web Push · VAPID) — 모바일 PWA 알림. Firebase 불필요.
#  application.yml 에 동일 기본값 내장되어 미설정이어도 동작. 운영은 새 키 생성 후 아래 값 교체 권장.
#  키 생성:  npx web-push generate-vapid-keys
PUSH_VAPID_PUBLIC_KEY=BDCIRs3qFazaY3rAAI8I_ah3npNV9ZxReu60vGH41lES4BdCmWBVaUv-Ixw8Wj5hTa1Zr5LvY-YKq1tktYbpxXE
PUSH_VAPID_PRIVATE_KEY=tWXkZ9h7QMhGieICfJVgpmFADbcFUo2EXcgEOhcCs3E
PUSH_VAPID_SUBJECT=mailto:admin@chinbiz.kr

# (구) 세션/서버 - 현재 스택에서는 미사용
SESSION_SECRET=change-this-to-a-long-random-string-in-production
PORT=3000
COOKIE_SECURE=false

# 백업 스크립트용(선택)
RETENTION_DAYS=14
